{
  "name": "TrueID",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Web dashboard", "protocol": "http" },
    "8080": { "label": "Engine admin API", "protocol": "http" }
  },
  "containerEnv": {
    "UV_PYTHON_INSTALL_DIR": "/usr/local/pythons"
  },
  "mounts": [
    "source=trueid-cargo,target=/usr/local/cargo,type=volume",
    "source=trueid-rustup,target=/usr/local/rustup,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
