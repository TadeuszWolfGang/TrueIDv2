# Rust build artifacts
/target/

# Local configuration (template: .env.example)
.env

# SQLite database (generated locally)
*.db
*.db-shm
*.db-wal

# Data directory
data/

# Backups
backups/
validation-reports/
lab-reports/

# OS files
.DS_Store
__pycache__/
*.pyc

# Private repo metadata
REPO_INFO.md
security-reports/

# Generated PKI material (scripts/gen-certs.sh) — never commit private keys
certs/*.pem
tls/*.pem
certs/*.key
tls/*.key
!certs/.gitkeep
!tls/.gitkeep
